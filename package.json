{
  "name": "campus-projects",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "tsx": "^4.23.15"
  }
}
